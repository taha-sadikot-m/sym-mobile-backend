# Copy to .env for local development. Deployed environments set these in Render, never in files.

ENVIRONMENT=local

# Local: the docker-compose database (see README).
# Neon: postgresql+asyncpg://<user>:<password>@<pooled host>/<db>?ssl=require  and DATABASE_POOLED=true
DATABASE_URL=postgresql+asyncpg://owner:owner_local@localhost:5433/sym
DATABASE_POOLED=false

# Any 32+ character random string locally; Render generates one when deployed.
SECRET_KEY=change-me-to-a-long-random-string-for-local-dev

CONTRACT_CHECK_ON_STARTUP=true

# Student sign-in tokens: any 32+ character random string.
JWT_SECRET=change-me-to-another-long-random-string

# Browser origins for the Expo web preview (phones don't need this).
CORS_ORIGINS=["http://localhost:8082","http://localhost:8081"]

# Optional outside services. Without them: emails go to the log, AI and transcription use built-in fallbacks.
# "log" prints emails (with their codes) to the server log instead of sending them.
EMAIL_DELIVERY=log
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Behind Render's proxy set 1 (the one X-Forwarded-For entry we can trust); locally 0.
TRUSTED_PROXY_HOPS=0

# Push notifications through Expo (needs no key; EXPO_ACCESS_TOKEN only with "Enhanced push security").
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# Scheduled jobs over HTTP for hosts without cron (Vercel): an outside scheduler calls POST /v1/jobs/run
# every 5 minutes with "Authorization: Bearer <this>". Any 32+ character random string; empty turns it off.
CRON_SECRET=

# Contact address shown on /privacy and /terms (optional).
SUPPORT_EMAIL=
